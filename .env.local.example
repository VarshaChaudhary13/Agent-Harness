# Template for running Agent Harness natively (no Docker).
#
# Copy this file to .env.local and fill in the values for your local
# PostgreSQL install. Do not commit .env.local.
#
# Docker mode does not use this file — it reads .env instead (see
# .env.example). See ADVANCED_LOCAL_SETUP.md for full setup steps.

DATABASE_NAME=ecommerce
DATABASE_USER=<your-local-db-role>
DATABASE_PASSWORD=<your-local-db-role-password>
DATABASE_HOST=localhost
DATABASE_PORT=5432

POSTGRES_ADMIN_USER=<your-os-username>
POSTGRES_ADMIN_PASSWORD=
POSTGRES_ADMIN_DATABASE=postgres

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-harness

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-harness

ENVIRONMENT=development
LOG_LEVEL=INFO
